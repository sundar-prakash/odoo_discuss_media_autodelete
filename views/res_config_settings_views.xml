<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_discuss_media_autodelete" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.discuss.media.autodelete</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Discuss Media Cleanup" name="discuss_media_cleanup_setting_container">
                    <setting string="Auto-delete Discuss Files" help="Automatically and permanently delete files/media shared in Discuss channels and direct messages after a set number of days. Runs once a day. This does not affect attachments in other apps.">
                        <field name="discuss_media_autodelete_enabled"/>
                        <div class="content-group" invisible="not discuss_media_autodelete_enabled">
                            <div class="mt16">
                                <label for="discuss_media_autodelete_days" string="Delete files older than"/>
                                <div class="d-flex align-items-center">
                                    <field name="discuss_media_autodelete_days" class="o_light_label mx-2" style="width: 80px;"/>
                                    <span>day(s)</span>
                                </div>
                            </div>
                            <div class="mt8">
                                <field name="discuss_media_autodelete_only_media" class="oe_inline"/>
                                <label for="discuss_media_autodelete_only_media" string="Only media files (images, videos, audio) — keep other file types"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
